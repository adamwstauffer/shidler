# Local-only content (student submissions, grading scratch, PII)
ignore-*/
**/ignore/

# Microsoft Office temp/lock files (e.g. ~$MyDoc.pptx while open)
~$*
**/~$*

# Local backup snapshots of master spreadsheets (rollback only, not source)
docs/spreadsheets/_backups/

# Shidler emails and personal/student correspondence (never on the public repo)
docs/emails/

# Session pickup prompts (/breakpoint working state; keep the README, ignore the rest)
docs/breakpoints/*
!docs/breakpoints/README.md

# Rosters, attendance, approved-access lists — student PII, never public.
# Fully local: no README whitelist, the directory should not appear on GitHub at all.
/rosters/

# Recommendation letters, resumes, applicant correspondence — student PII, never public.
# Fully local: no README whitelist, the directory should not appear on GitHub at all.
/recommendations/

# Deprecated/historical materials — local-only since 2026-08-06 (untracked to declutter the
# public tree; pre-removal contents remain in git history)
/_archive/

# Claude Code agent worktrees — harness state (a full nested checkout), never committed
.claude/worktrees/

# Instructor tooling — local-only since 2026-09-29 (Adam's personal Claude Code config, grading
# scanners, repo scripts). Root .claude/ only: students' sample repos keep their .claude/skills/.
/.claude/
**/_tools/
/scripts/

